{
  "name": "manim-studio",
  "productName": "Manim Studio",
  "version": "0.1.0",
  "description": "Desktop editor for maths explainer videos made with manim, written with Claude",
  "author": "Luka Ražem",
  "license": "MIT",
  "repository": "github:lukaznj/manim-studio",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "test:python": "cd python && pixi run python -m unittest discover tests",
    "fetch-pixi": "node scripts/fetch-pixi.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.293",
    "@anthropic-ai/sdk": "^0.132.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "electron-updater": "^6.8.9",
    "isomorphic-git": "^1.43.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.52.0",
    "monaco-editor": "^0.57.0",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "zustand": "^5.0.15"
  }
}
